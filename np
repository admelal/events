using System.Text;

namespace GaValveInspectionGisMaximo.Services;

internal static class HttpContentExtensions

{
  private const int DefaultBufferSize = 8_192;

  public static async Task<string> ReadLimitedStringAsync(

      this HttpContent content,

      int maxCharacters,

      CancellationToken cancellationToken)

  {
    ArgumentNullException.ThrowIfNull(content);

    if (maxCharacters <= 0)

    {
      throw new ArgumentOutOfRangeException(

          nameof(maxCharacters),

          maxCharacters,

          "The response limit must be greater than zero.");
    }

    if (maxCharacters == int.MaxValue)

    {
      throw new ArgumentOutOfRangeException(

          nameof(maxCharacters),

          maxCharacters,

          "The response limit is too large.");
    }

    await using var stream =

        await content
            .ReadAsStreamAsync(cancellationToken)

            .ConfigureAwait(false);

    using var reader = new StreamReader(

        stream,

        Encoding.UTF8,

        detectEncodingFromByteOrderMarks: true,

        bufferSize: DefaultBufferSize,

        leaveOpen: false);

    var maximumReadLength =

        maxCharacters + 1;

    var buffer = new char[

        Math.Min(

            maximumReadLength,

            DefaultBufferSize)];

    var result = new StringBuilder(

        Math.Min(

            maxCharacters,

            DefaultBufferSize));

    while (result.Length < maximumReadLength)

    {
      var remaining =

          Math.Min(

              buffer.Length,

              maximumReadLength - result.Length);

      var charactersRead =

          await reader
              .ReadAsync(

                  buffer.AsMemory(0, remaining),

                  cancellationToken)

              .ConfigureAwait(false);

      if (charactersRead == 0)

      {
        break;
      }

      result.Append(

          buffer,

          0,

          charactersRead);
    }

    if (result.Length > maxCharacters)

    {
      throw new DownstreamRequestException(

          "The downstream response exceeded the configured " +

              "safety limit.",

          statusCode: null,

          isTransient: false);
    }

    return result.ToString();
  }
}


