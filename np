           CancellationTokenSource.CreateLinkedTokenSource(
               cancellationToken);

       timeoutSource.CancelAfter(_requestTimeout);

       using var request = new HttpRequestMessage(
           HttpMethod.Post,
           _endpoint);

       request.Headers.Authorization =
           new AuthenticationHeaderValue(
               "Basic",
               _basicCredential);

       request.Headers.TryAddWithoutValidation(
           "x-correlation-id",
           command.CorrelationId);

       request.Headers.TryAddWithoutValidation(
           "Idempotency-Key",
           command.CorrelationId);

       request.Content = JsonContent.Create(
           command.Payload,
           options: JsonDefaults.Options);

       var client = _httpClientFactory.CreateClient(
           HttpClientName);

       try
       {
           using var response = await client.SendAsync(
                   request,
                   HttpCompletionOption.ResponseHeadersRead,
                   timeoutSource.Token)
               .ConfigureAwait(false);

           if (!response.IsSuccessStatusCode)
           {
               throw DownstreamRequestException.ForHttpStatus(
                   "Maximo",
                   response.StatusCode);
           }

           return (int)response.StatusCode;
       }
       catch (OperationCanceledException exception)
           when (!cancellationToken.IsCancellationRequested)
       {
           throw new DownstreamRequestException(
               "The Maximo request timed out.",
               HttpStatusCode.RequestTimeout,
               isTransient: true,
               exception);
       }
       catch (HttpRequestException exception)
       {
           throw new DownstreamRequestException(
               "The Maximo request failed due to a network error.",
               exception.StatusCode,
               isTransient: true,
               exception);
       }
   }

   private static Uri BuildEndpoint(
       string host,
       string path)
   {
       var baseUri = new Uri(
           $"{host.TrimEnd('/')}/",
           UriKind.Absolute);

       return new Uri(
           baseUri,
           path.TrimStart('/'));
   }

   private static string NormalizeBasicCredential(
       string configuredValue)
   {
       if (string.IsNullOrWhiteSpace(configuredValue))
       {
           throw new InvalidOperationException(
               "MaximoBasicAuth is required.");
       }

       var credential = configuredValue.Trim();
       const string basicPrefix = "Basic ";

       if (credential.StartsWith(
               basicPrefix,
               StringComparison.OrdinalIgnoreCase))
       {
           credential = credential[basicPrefix.Length..].Trim();
       }

       if (string.IsNullOrWhiteSpace(credential))
       {
           throw new InvalidOperationException(
               "MaximoBasicAuth must contain a Basic credential.");
       }

       return credential;
   }

   private static void ValidateCorrelationId(
       string correlationId)
   {
       if (string.IsNullOrWhiteSpace(correlationId))
       {
           throw new ArgumentException(
               "Correlation ID is required.",
               nameof(correlationId));
       }

       if (correlationId.Length >
               MaximumCorrelationIdLength ||
           correlationId.Any(char.IsControl))
       {
           throw new ArgumentException(
               "Correlation ID contains invalid characters or " +
               $"exceeds {MaximumCorrelationIdLength} characters.",
               nameof(correlationId));
       }
   }
}

