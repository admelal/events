namespace GaValveInspectionGisMaximo.Contracts;
public static class MessageTypes
{
    public const string GisToMaximo = "GisToMaximo";
    public const string MaximoToGis = "MaximoToGis";

    public static bool TryNormalize(string? value, out string normalized)
    {
        normalized = value?.Trim().Replace('-', '_').ToUpperInvariant() switch
        {
            "GIS_TO_MAXIMO" or "GISTOMAXIMO" => GisToMaximo,
            "MAXIMO_TO_GIS" or "MAXIMOTOGIS" => MaximoToGis,
            _ => string.Empty
        };

        return normalized.Length > 0;
    }

    public static bool TryFromRoute(string? value, out string messageType)
    {
        messageType = value?.Trim().ToLowerInvariant() switch
        {
            "gis-to-maximo" => GisToMaximo,
            "maximo-to-gis" => MaximoToGis,
            _ => string.Empty
        };

        return messageType.Length > 0;
    }
}

