using System.Net;
namespace GaValveInspectionGisMaximo.Services;
public sealed class DownstreamRequestException : Exception
{
   public DownstreamRequestException(
       string message,
       HttpStatusCode? statusCode,
       bool isTransient,
       Exception? innerException = null)
       : base(message, innerException)
   {
       StatusCode = statusCode;
       IsTransient = isTransient;
   }
   public HttpStatusCode? StatusCode { get; }
   public bool IsTransient { get; }
   public static DownstreamRequestException ForHttpStatus(
       string target,
       HttpStatusCode statusCode)
   {
       var isTransient =
           statusCode is
               HttpStatusCode.RequestTimeout or
               HttpStatusCode.TooManyRequests ||
           (int)statusCode >= 500;
       return new DownstreamRequestException(
           $"{target} returned HTTP {(int)statusCode}.",
           statusCode,
           isTransient);
   }
   public static DownstreamRequestException ForTimeout(
       string target,
       Exception innerException)
   {
       return new DownstreamRequestException(
           $"{target} request timed out.",
           statusCode: HttpStatusCode.RequestTimeout,
           isTransient: true,
           innerException);
   }
   public static DownstreamRequestException ForTransportFailure(
       string target,
       HttpRequestException innerException)
   {
       var statusCode = innerException.StatusCode;
       var isTransient =
           statusCode is null ||
           statusCode is
               HttpStatusCode.RequestTimeout or
               HttpStatusCode.TooManyRequests ||
           (int)statusCode.Value >= 500;
       return new DownstreamRequestException(
           $"{target} request failed before a successful " +
           "HTTP response was received.",
           statusCode,
           isTransient,
           innerException);
   }
}
