using GaValveInspectionGisMaximo.Contracts;
using Microsoft.Azure.Functions.Worker;
using Microsoft.DurableTask;

namespace GaValveInspectionGisMaximo.Functions;

public sealed class ValveInspectionOrchestrations
{
   [Function(FunctionNames.GisToMaximoOrchestrator)]
   public async Task<IntegrationResult> RunGisToMaximoAsync(
       [OrchestrationTrigger]
       TaskOrchestrationContext context)
   {
       ArgumentNullException.ThrowIfNull(context);

       var input = GetRequiredInput(
           context,
           MessageTypes.GisToMaximo,
           "GIS-to-Maximo");

       var command =
           await context.CallActivityAsync<MaximoSendCommand>(
               FunctionNames.TransformGisToMaximo,
               input);

       return await context.CallActivityAsync<IntegrationResult>(
           FunctionNames.SendToMaximo,
           command,
           CreateTaskOptions(input.RetryPolicy!));
   }

   [Function(FunctionNames.MaximoToGisOrchestrator)]
   public async Task<IntegrationResult> RunMaximoToGisAsync(
       [OrchestrationTrigger]
       TaskOrchestrationContext context)
   {
       ArgumentNullException.ThrowIfNull(context);

       var input = GetRequiredInput(
           context,
           MessageTypes.MaximoToGis,
           "Maximo-to-GIS");

       var command =
           await context.CallActivityAsync<GisSendCommand>(
               FunctionNames.TransformMaximoToGis,
               input);

       return await context.CallActivityAsync<IntegrationResult>(
           FunctionNames.SendToGis,
           command,
           CreateTaskOptions(input.RetryPolicy!));
   }

   private static ValveInspectionMessage GetRequiredInput(
       TaskOrchestrationContext context,
       string expectedMessageType,
       string integrationDirection)
   {
       var input =
           context.GetInput<ValveInspectionMessage>()
           ?? throw new InvalidOperationException(
               $"{integrationDirection} orchestration input is required.");

       if (input.Payload is null)
       {
           throw new InvalidOperationException(
               $"{integrationDirection} payload is required.");
       }

       if (string.IsNullOrWhiteSpace(input.CorrelationId))
       {
           throw new InvalidOperationException(
               $"{integrationDirection} correlation ID is required.");
       }

       if (!string.Equals(
               input.MessageType,
               expectedMessageType,
               StringComparison.OrdinalIgnoreCase))
       {
           throw new InvalidOperationException(
               $"{integrationDirection} received an unsupported " +
               $"message type '{input.MessageType}'.");
       }

       if (input.RetryPolicy is null)
       {
           throw new InvalidOperationException(
               $"{integrationDirection} retry policy is required.");
       }

       return input;
   }

   private static TaskOptions CreateTaskOptions(
       WorkflowRetryPolicy options)
   {
       ArgumentNullException.ThrowIfNull(options);

       var retryPolicy = new RetryPolicy(
           maxNumberOfAttempts:
               options.MaxAttempts,
           firstRetryInterval:
               TimeSpan.FromSeconds(
                   options.FirstDelaySeconds),
           backoffCoefficient:
               options.BackoffCoefficient,
           maxRetryInterval:
               TimeSpan.FromSeconds(
                   options.MaxDelaySeconds),
           retryTimeout:
               TimeSpan.FromSeconds(
                   options.TimeoutSeconds));

       return TaskOptions.FromRetryPolicy(retryPolicy);
   }
}
