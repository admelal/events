   private TimeSpan CalculateRetryDelay(
       int failedAttempt)
   {
       var exponentialDelaySeconds =
           _options.GisTokenFirstDelaySeconds *
           Math.Pow(
               _options.GisTokenBackoffCoefficient,
               failedAttempt - 1);

       var boundedDelaySeconds = Math.Min(
           exponentialDelaySeconds,
           _options.GisTokenMaxDelaySeconds);

       return TimeSpan.FromSeconds(
           boundedDelaySeconds);
   }

   private void LogCachedToken(
       CachedToken token,
       string message)
   {
       _logger.LogDebug(
           "{Message} ExpiresAtUtc={ExpiresAtUtc}, " +
           "RefreshAtUtc={RefreshAtUtc}",
           message,
           token.ExpiresAtUtc,
           GetRefreshAtUtc(token.ExpiresAtUtc));
