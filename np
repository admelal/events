using System.Globalization;
using System.Net;
using System.Text.Json;
using System.Text.Json.Serialization;
using GaValveInspectionGisMaximo.Configuration;
using GaValveInspectionGisMaximo.Serialization;
using Microsoft.Extensions.Logging;
using Microsoft.Extensions.Options;

namespace GaValveInspectionGisMaximo.Services;

public interface IArcGisTokenProvider
{
   Task<string> GetTokenAsync(
       CancellationToken cancellationToken);

   void InvalidateToken();
}

public sealed class ArcGisTokenProvider :
   IArcGisTokenProvider
{
   public const string HttpClientName = "ArcGisToken";

   private const int MaximumResponseCharacters = 65_536;

   private readonly IHttpClientFactory _httpClientFactory;
   private readonly ILogger<ArcGisTokenProvider> _logger;
   private readonly DownstreamOptions _options;
   private readonly Uri _tokenEndpoint;
   private readonly TimeSpan _requestTimeout;
   private readonly SemaphoreSlim _refreshLock = new(1, 1);

   private CachedToken? _cachedToken;

   public ArcGisTokenProvider(
       IHttpClientFactory httpClientFactory,
       IOptions<DownstreamOptions> options,
       ILogger<ArcGisTokenProvider> logger)
   {
       ArgumentNullException.ThrowIfNull(httpClientFactory);
       ArgumentNullException.ThrowIfNull(options);
       ArgumentNullException.ThrowIfNull(options.Value);
       ArgumentNullException.ThrowIfNull(logger);

       _httpClientFactory = httpClientFactory;
       _logger = logger;
       _options = options.Value;

       _tokenEndpoint = BuildEndpoint(
           _options.GisHost,
           _options.GisTokenPath);

       _requestTimeout = TimeSpan.FromSeconds(
           _options.GisTimeoutSeconds);
   }

   public async Task<string> GetTokenAsync(
       CancellationToken cancellationToken)
   {
       var cachedToken = Volatile.Read(
           ref _cachedToken);

       if (IsUsable(cachedToken))
       {
           LogCachedToken(
               cachedToken!,
               "Using cached ArcGIS access token.");

           return cachedToken!.Value;
       }

       await _refreshLock
           .WaitAsync(cancellationToken)
           .ConfigureAwait(false);

       try
       {
           // Another invocation may have refreshed the token
           // while this invocation was waiting for the lock.
           cachedToken = Volatile.Read(
               ref _cachedToken);

           if (IsUsable(cachedToken))
           {
               LogCachedToken(
                   cachedToken!,
                   "Using ArcGIS access token refreshed " +
                   "by another invocation.");

               return cachedToken!.Value;
           }

           var refreshedToken = await RequestTokenWithRetryAsync(
                   cancellationToken)
               .ConfigureAwait(false);

           Volatile.Write(
               ref _cachedToken,
               refreshedToken);

           _logger.LogInformation(
               "ArcGIS access token generated successfully and cached. " +
               "ExpiresAtUtc={ExpiresAtUtc}, RefreshAtUtc={RefreshAtUtc}",
               refreshedToken.ExpiresAtUtc,
               GetRefreshAtUtc(refreshedToken.ExpiresAtUtc));

           return refreshedToken.Value;
       }
       catch (OperationCanceledException)
           when (cancellationToken.IsCancellationRequested)
       {
           throw;
       }
       catch (Exception exception)
       {
           _logger.LogError(
               exception,
               "Unable to obtain an ArcGIS access token. " +
               "TokenEndpoint={TokenEndpoint}, TokenClient={TokenClient}",
               _tokenEndpoint,
               _options.GisTokenClient);

           throw;
       }
       finally
       {
           _refreshLock.Release();
       }
   }

   public void InvalidateToken()
   {
       var invalidatedToken = Interlocked.Exchange(
           ref _cachedToken,
           null);

       if (invalidatedToken is null)
       {
           _logger.LogDebug(
               "ArcGIS token invalidation was requested, " +
               "but no token was cached.");

           return;
       }

       _logger.LogWarning(
           "Cached ArcGIS access token was invalidated. " +
           "PreviousExpiresAtUtc={PreviousExpiresAtUtc}",
           invalidatedToken.ExpiresAtUtc);
   }

   private async Task<CachedToken> RequestTokenWithRetryAsync(
       CancellationToken cancellationToken)
   {
       using var retryTimeoutSource =
           CancellationTokenSource.CreateLinkedTokenSource(
               cancellationToken);

       retryTimeoutSource.CancelAfter(
           TimeSpan.FromSeconds(
               _options.GisTokenRetryTimeoutSeconds));

       try
       {
           for (var attempt = 1;
                attempt <= _options.GisTokenMaxAttempts;
                attempt++)
           {
               try
               {
                   _logger.LogInformation(
                       "Requesting a new ArcGIS access token. " +
                       "TokenEndpoint={TokenEndpoint}, " +
                       "TokenClient={TokenClient}, Attempt={Attempt}, " +
                       "MaximumAttempts={MaximumAttempts}",
                       _tokenEndpoint,
                       _options.GisTokenClient,
                       attempt,
                       _options.GisTokenMaxAttempts);

                   var token = await RequestTokenOnceAsync(
                           retryTimeoutSource.Token)
                       .ConfigureAwait(false);

                   _logger.LogInformation(
                       "ArcGIS token request succeeded. " +
                       "Attempt={Attempt}, MaximumAttempts={MaximumAttempts}, " +
                       "ExpiresAtUtc={ExpiresAtUtc}",
                       attempt,
                       _options.GisTokenMaxAttempts,
                       token.ExpiresAtUtc);

                   return token;
               }
               catch (TokenRequestAttemptException exception)
               {
                   if (!exception.IsTransient ||
                       attempt >= _options.GisTokenMaxAttempts)
                   {
                       _logger.LogError(
                           exception.DownstreamException,
                           "ArcGIS token request failed permanently. " +
                           "Attempt={Attempt}, " +
                           "MaximumAttempts={MaximumAttempts}, " +
                           "IsTransient={IsTransient}",
                           attempt,
                           _options.GisTokenMaxAttempts,
                           exception.IsTransient);

                       throw exception.DownstreamException;
                   }

                   var delay = CalculateRetryDelay(
                       attempt);

                   _logger.LogWarning(
                       exception.DownstreamException,
                       "ArcGIS token request failed transiently. " +
                       "The request will be retried. " +
                       "Attempt={Attempt}, " +
                       "MaximumAttempts={MaximumAttempts}, " +
                       "RetryDelaySeconds={RetryDelaySeconds}",
                       attempt,
                       _options.GisTokenMaxAttempts,
                       delay.TotalSeconds);

                   await Task.Delay(
                           delay,
                           retryTimeoutSource.Token)
                       .ConfigureAwait(false);
               }
           }

           throw new InvalidOperationException(
               "ArcGIS token retry processing completed without a result.");
       }
       catch (OperationCanceledException exception)
           when (!cancellationToken.IsCancellationRequested)
       {
           _logger.LogError(
               exception,
               "ArcGIS token retry timeout was exceeded. " +
               "RetryTimeoutSeconds={RetryTimeoutSeconds}",
               _options.GisTokenRetryTimeoutSeconds);

           throw new DownstreamRequestException(
               "The ArcGIS token retry timeout was exceeded.",
               HttpStatusCode.RequestTimeout,
               isTransient: true,
               exception);
       }
   }

   private async Task<CachedToken> RequestTokenOnceAsync(
       CancellationToken retryCancellationToken)
   {
       var formValues =
           new List<KeyValuePair<string, string>>
           {
               new("f", "json"),
               new("username", _options.GisUsername),
               new("password", _options.GisPassword),
               new("client", _options.GisTokenClient),
               new(
                   "expiration",
                   _options.GisTokenExpirationMinutes.ToString(
                       CultureInfo.InvariantCulture))
           };

       if (string.Equals(
               _options.GisTokenClient,
               "referer",
               StringComparison.OrdinalIgnoreCase))
       {
           ArgumentException.ThrowIfNullOrWhiteSpace(
               _options.GisReferer);

           formValues.Add(
               new KeyValuePair<string, string>(
                   "referer",
                   _options.GisReferer));
       }

       using var requestTimeoutSource =
           CancellationTokenSource.CreateLinkedTokenSource(
               retryCancellationToken);

       requestTimeoutSource.CancelAfter(
           _requestTimeout);

       using var request = new HttpRequestMessage(
           HttpMethod.Post,
           _tokenEndpoint)
       {
           Content = new FormUrlEncodedContent(
               formValues)
       };

       var client = _httpClientFactory.CreateClient(
           HttpClientName);

       try
       {
           using var response = await client
               .SendAsync(
                   request,
                   HttpCompletionOption.ResponseHeadersRead,
                   requestTimeoutSource.Token)
               .ConfigureAwait(false);

           var responseBody = await response.Content
               .ReadLimitedStringAsync(
                   MaximumResponseCharacters,
                   requestTimeoutSource.Token)
               .ConfigureAwait(false);

           _logger.LogInformation(
               "ArcGIS token endpoint responded. " +
               "HttpStatusCode={HttpStatusCode}, " +
               "ResponseLength={ResponseLength}",
               (int)response.StatusCode,
               responseBody.Length);

           if (!response.IsSuccessStatusCode)
           {
               var downstreamException =
                   DownstreamRequestException.ForHttpStatus(
                       "ArcGIS token endpoint",
                       response.StatusCode);

               throw new TokenRequestAttemptException(
                   downstreamException,
                   IsTransientHttpStatus(response.StatusCode));
           }

           var arcGisError =
               ArcGisErrorParser.GetErrorOrThrow(
                   responseBody,
                   "ArcGIS token endpoint");

           if (arcGisError is not null)
           {
               var downstreamException =
                   ArcGisErrorParser.CreateException(
                       arcGisError,
                       "ArcGIS token endpoint");

               throw new TokenRequestAttemptException(
                   downstreamException,
                   ArcGisErrorParser.IsTransientError(
                       arcGisError.Code));
           }

           var tokenResponse = DeserializeTokenResponse(
               responseBody);

           var expiresAtUtc = GetExpiration(
               tokenResponse.Expires);

           _logger.LogInformation(
               "ArcGIS token response was validated successfully. " +
               "ExpiresAtUtc={ExpiresAtUtc}, RefreshAtUtc={RefreshAtUtc}",
               expiresAtUtc,
               GetRefreshAtUtc(expiresAtUtc));

           return new CachedToken(
               tokenResponse.Token!,
               expiresAtUtc);
       }
       catch (OperationCanceledException exception)
           when (!retryCancellationToken.IsCancellationRequested)
       {
           var downstreamException =
               new DownstreamRequestException(
                   "The ArcGIS token request timed out.",
                   HttpStatusCode.RequestTimeout,
                   isTransient: true,
                   exception);

           throw new TokenRequestAttemptException(
               downstreamException,
               isTransient: true);
       }
       catch (HttpRequestException exception)
       {
           var downstreamException =
               new DownstreamRequestException(
                   "The ArcGIS token request failed because of " +
                   "a network error.",
                   exception.StatusCode,
                   isTransient: true,
                   exception);

           throw new TokenRequestAttemptException(
               downstreamException,
               isTransient: true);
       }
   }

   private bool IsUsable(
       CachedToken? token)
   {
       if (token is null ||
           string.IsNullOrWhiteSpace(token.Value))
       {
           return false;
       }

       return DateTimeOffset.UtcNow <
              GetRefreshAtUtc(token.ExpiresAtUtc);
   }

   private DateTimeOffset GetRefreshAtUtc(
       DateTimeOffset expiresAtUtc)
   {
       return expiresAtUtc.AddMinutes(
           -_options.GisTokenRefreshSkewMinutes);
   }

   private TimeSpan CalculateRetryDelay(
       int failedAttempt)
   {
       var exponentialDelaySeconds =
           _options.GisTokenFirstDelaySeconds *
           Math.Pow(
               _options.GisTokenBackoffCoefficient,
               failedAttempt - 1);

       var boundedDelaySeconds = Math.Min(
           exponentialDelaySeconds,
           _options.GisTokenMaxDelaySeconds);

       return TimeSpan.FromSeconds(
           boundedDelaySeconds);
   }

   private void LogCachedToken(
       CachedToken token,
       string message)
   {
       _logger.LogDebug(
           "{Message} ExpiresAtUtc={ExpiresAtUtc}, " +
           "RefreshAtUtc={RefreshAtUtc}",
