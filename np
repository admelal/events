   [Function(FunctionNames.Health)]
   public async Task<HttpResponseData> RunAsync(
       [HttpTrigger(
           AuthorizationLevel.Anonymous,
           "get",
           Route = "health")]
       HttpRequestData request,
       CancellationToken cancellationToken)
   {
       ArgumentNullException.ThrowIfNull(request);
       var correlationId =
           GetOrCreateCorrelationId(request);
       var response =
           request.CreateResponse(HttpStatusCode.OK);
       response.Headers.Add(
           "Content-Type",
           "application/json; charset=utf-8");
       response.Headers.Add(
           CorrelationIdHeader,
           correlationId);
       var responseBody = new
       {
           status = "Healthy",
           service = "GaValveInspectionGisMaximo",
           timestampUtc = DateTimeOffset.UtcNow
       };
       await response.WriteStringAsync(
               JsonSerializer.Serialize(
                   responseBody,
                   JsonDefaults.Options),
               cancellationToken)
           .ConfigureAwait(false);
       return response;
   }
   private static string GetOrCreateCorrelationId(
       HttpRequestData request)
   {
       if (request.Headers.TryGetValues(
               CorrelationIdHeader,
               out var values))
       {
           var correlationId =
               values.FirstOrDefault()?.Trim();
           if (IsValidCorrelationId(correlationId))
           {
               return correlationId!;
           }
       }
       return Guid.NewGuid().ToString("D");
   }
   private static bool IsValidCorrelationId(
       string? correlationId)
   {
       return !string.IsNullOrWhiteSpace(correlationId) &&
              correlationId.Length <=
              MaximumCorrelationIdLength &&
              correlationId.All(character =>
                  char.IsLetterOrDigit(character) ||
                  character is '-' or '_' or '.' or ':');
   }
