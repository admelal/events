using Microsoft.Extensions.Configuration;

namespace GaValveInspectionGisMaximo.Services;

internal static class DownstreamEndpointBuilder
{
   public static Uri Build(
       IConfiguration configuration,
       string hostKey,
       string pathKey)
   {
       ArgumentNullException.ThrowIfNull(configuration);
       ArgumentException.ThrowIfNullOrWhiteSpace(hostKey);
       ArgumentException.ThrowIfNullOrWhiteSpace(pathKey);

       var configuredHost = configuration[hostKey]?.Trim();
       var configuredPath = configuration[pathKey]?.Trim();

       if (string.IsNullOrWhiteSpace(configuredHost) ||
           !Uri.TryCreate(
               configuredHost,
               UriKind.Absolute,
               out var host) ||
           !string.Equals(
               host.Scheme,
               Uri.UriSchemeHttps,
               StringComparison.OrdinalIgnoreCase) ||
           string.IsNullOrWhiteSpace(host.Host) ||
           !string.IsNullOrEmpty(host.UserInfo) ||
           !string.Equals(
               host.AbsolutePath,
               "/",
               StringComparison.Ordinal) ||
           !string.IsNullOrEmpty(host.Query) ||
           !string.IsNullOrEmpty(host.Fragment))
       {
           throw new InvalidOperationException(
               $"{hostKey} must contain only an absolute HTTPS host.");
       }

       if (string.IsNullOrWhiteSpace(configuredPath) ||
           !configuredPath.StartsWith(
               "/",
               StringComparison.Ordinal) ||
           configuredPath.StartsWith(
               "//",
               StringComparison.Ordinal) ||
           configuredPath.Length == 1 ||
           configuredPath.Contains('?') ||
           configuredPath.Contains('#') ||
           configuredPath.Contains('\\') ||
           configuredPath.Any(character =>
               char.IsWhiteSpace(character) ||
               char.IsControl(character)) ||
           ContainsUnsafePathSegment(configuredPath))
       {
           throw new InvalidOperationException(
               $"{pathKey} must contain a valid endpoint path " +
               "beginning with '/'.");
       }

       if (!Uri.TryCreate(
               host,
               configuredPath,
               out var endpoint) ||
           !string.Equals(
               endpoint.Scheme,
               host.Scheme,
               StringComparison.OrdinalIgnoreCase) ||
           !string.Equals(
               endpoint.Host,
               host.Host,
               StringComparison.OrdinalIgnoreCase) ||
           endpoint.Port != host.Port)
       {
           throw new InvalidOperationException(
               $"{hostKey} and {pathKey} do not form a valid " +
               "HTTPS endpoint.");
       }

       return endpoint;
   }

   private static bool ContainsUnsafePathSegment(string path)
   {
       foreach (var segment in path.Split(
                    '/',
                    StringSplitOptions.RemoveEmptyEntries))
       {
           string decodedSegment;

           try
           {
               decodedSegment =
                   Uri.UnescapeDataString(segment);
           }
           catch (UriFormatException)
           {
               return true;
           }

           if (decodedSegment is "." or ".." ||
               decodedSegment.Contains('/') ||
               decodedSegment.Contains('\\') ||
               decodedSegment.Any(char.IsControl))
           {
               return true;
           }
       }

       return false;
   }
}


