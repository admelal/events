using System.Globalization;
using System.Net.Http.Headers;
using System.Text;
using System.Text.Json;
using GaValveInspectionsSalesforce.Models;
using GaValveInspectionsSalesforce.Transformers;
using Microsoft.Extensions.Configuration;
using Microsoft.Extensions.Logging;

namespace GaValveInspectionsSalesforce.Services;

public sealed class SalesforceIrMessageService
{
    private static readonly JsonSerializerOptions JsonOptions = new() { PropertyNameCaseInsensitive = true };
    private readonly HttpClient _httpClient;
    private readonly IConfiguration _configuration;
    private readonly MaximoToSalesforceService _salesforceService;
    private readonly IntegrationPayloadLogger _payloadLogger;
    private readonly ILogger<SalesforceIrMessageService> _logger;

    public SalesforceIrMessageService(HttpClient httpClient, IConfiguration configuration,
        MaximoToSalesforceService salesforceService, IntegrationPayloadLogger payloadLogger,
        ILogger<SalesforceIrMessageService> logger)
    {
        _httpClient = httpClient ?? throw new ArgumentNullException(nameof(httpClient));
        _configuration = configuration ?? throw new ArgumentNullException(nameof(configuration));
        _salesforceService = salesforceService ?? throw new ArgumentNullException(nameof(salesforceService));
        _payloadLogger = payloadLogger ?? throw new ArgumentNullException(nameof(payloadLogger));
        _logger = logger ?? throw new ArgumentNullException(nameof(logger));
    }

    public Task<int> ProcessAsync(string correlationId, CancellationToken ct = default) =>
        ProcessAsync("new", correlationId, ct);

    public async Task<int> ProcessAsync(string requestType, string correlationId, CancellationToken ct = default)
    {
        if (requestType is not ("new" or "retry"))
            throw new ArgumentException("requestType must be 'new' or 'retry'.", nameof(requestType));

        correlationId = string.IsNullOrWhiteSpace(correlationId)
            ? Guid.NewGuid().ToString("N") : correlationId.Trim();
        int messageCount = GetMessageCount(requestType);
        Uri sfEndpoint = BuildEndpoint("SalesforceHost", "SalesforceIrMessagesPath");
        Uri mxEndpoint = BuildEndpoint("MaximoHost", "MaximoValvesPath");

        ct.ThrowIfCancellationRequested();
        string token = await _salesforceService.GetSalesforceTokenAsync(correlationId);
        List<SalesforceIrMessage> messages = await GetMessagesAsync(
            sfEndpoint, token, requestType, messageCount, correlationId, ct);

        List<SalesforceIrMessageUpdate> updates = new();
        HashSet<string> seenIds = new(StringComparer.Ordinal);
        int success = 0, failed = 0, unknown = 0;

        foreach (SalesforceIrMessage message in messages)
        {
            ct.ThrowIfCancellationRequested();
            string? id = message.Id?.Trim();
            if (string.IsNullOrWhiteSpace(id) || !seenIds.Add(id))
            {
                failed++;
                _logger.LogError("Missing or duplicate IRMessage Id. CorrelationId: {CorrelationId}", correlationId);
                continue;
            }

            try
            {
                if (message.Request is null)
                    throw new InvalidOperationException("NG_Request__c is missing.");

                string source = message.Request.ToJsonString();
                _payloadLogger.LogPayload("Salesforce", "IRMessages transformation", "Input", source, correlationId, id);
                string normalized = SalesforceIrMessageNormalizer.Normalize(source);
                string maximoPayload = SalesforceToMaximoStatusTransformer.Transform(normalized, correlationId);
                using (JsonDocument parsed = JsonDocument.Parse(maximoPayload))
                {
                    if (parsed.RootElement.ValueKind != JsonValueKind.Object)
                        throw new InvalidOperationException("Maximo POST requires one JSON object.");
                }
                _payloadLogger.LogPayload("Maximo", "IRMessages transformation", "Output", maximoPayload, correlationId, id);
                await PostMaximoAsync(mxEndpoint, maximoPayload, id, correlationId, ct);
                updates.Add(new SalesforceIrMessageUpdate { RecordId = id, Status = "Success" });
                success++;
            }
            catch (OperationCanceledException) when (ct.IsCancellationRequested) { throw; }
            catch (OperationCanceledException ex)
            {
                unknown++;
                _logger.LogError(ex, "Maximo outcome unknown (timeout). RecordId: {RecordId}", id);
            }
            catch (HttpRequestException ex) when (ex.StatusCode is null)
            {
                unknown++;
                _logger.LogError(ex, "Maximo outcome unknown (transport failure). RecordId: {RecordId}", id);
            }
            catch (Exception ex)
            {
                failed++;
                _logger.LogError(ex, "IRMessage failed. RecordId: {RecordId}, CorrelationId: {CorrelationId}", id, correlationId);
                updates.Add(new SalesforceIrMessageUpdate { RecordId = id, Status = "Failed" });
            }
        }

        if (updates.Count > 0)
            await PatchSalesforceAsync(sfEndpoint, token, updates, correlationId, ct);

        _logger.LogInformation("IRMessages complete. RequestType: {RequestType}, Retrieved: {Retrieved}, Success: {Success}, Failed: {Failed}, Unknown: {Unknown}, CorrelationId: {CorrelationId}",
            requestType, messages.Count, success, failed, unknown, correlationId);
        if (failed > 0 || unknown > 0)
            throw new InvalidOperationException($"IRMessages had {failed} failed and {unknown} unknown records. CorrelationId: {correlationId}");
        return success;
    }

    private async Task<List<SalesforceIrMessage>> GetMessagesAsync(Uri endpoint, string token,
        string requestType, int messageCount, string correlationId, CancellationToken ct)
    {
        UriBuilder builder = new(endpoint)
        {
            Query = $"requestType={Uri.EscapeDataString(requestType)}&messageCount={messageCount.ToString(CultureInfo.InvariantCulture)}"
        };
        using HttpRequestMessage request = SalesforceRequest(HttpMethod.Get, builder.Uri, token, correlationId);
        _payloadLogger.LogPayload("Salesforce", "IRMessages GET", "Request parameters",
            JsonSerializer.Serialize(new { requestType, messageCount }), correlationId);
        using HttpResponseMessage response = await _httpClient.SendAsync(request, ct);
        string body = await response.Content.ReadAsStringAsync(ct);
        _payloadLogger.LogPayload("Salesforce", "IRMessages GET", "Response", body, correlationId);
        EnsureSuccess(response, "Salesforce GET", correlationId);
        try
        {
            return JsonSerializer.Deserialize<List<SalesforceIrMessage>>(body, JsonOptions)
                ?? throw new InvalidOperationException("Salesforce GET returned JSON null.");
        }
        catch (JsonException ex)
        {
            throw new InvalidOperationException("Salesforce GET returned invalid JSON.", ex);
        }
    }

    private async Task PostMaximoAsync(Uri endpoint, string payload, string recordId,
        string correlationId, CancellationToken ct)
    {
        using HttpRequestMessage request = new(HttpMethod.Post, endpoint);
        request.Headers.Authorization = new AuthenticationHeaderValue("Basic", GetBasicAuth());
        request.Headers.TryAddWithoutValidation("x-correlation-id", correlationId);
        request.Headers.Accept.Add(new MediaTypeWithQualityHeaderValue("application/json"));
        request.Content = new StringContent(payload, Encoding.UTF8, "application/json");
        _payloadLogger.LogPayload("Maximo", "WorkOrder Status POST", "Request", payload, correlationId, recordId);
        using HttpResponseMessage response = await _httpClient.SendAsync(request, ct);
        string body = await response.Content.ReadAsStringAsync(ct);
        _payloadLogger.LogPayload("Maximo", "WorkOrder Status POST", "Response", body, correlationId, recordId);
        EnsureSuccess(response, "Maximo POST", correlationId, recordId);
    }

    private async Task PatchSalesforceAsync(Uri endpoint, string token,
        IReadOnlyCollection<SalesforceIrMessageUpdate> updates, string correlationId, CancellationToken ct)
    {
        // A collection always serializes to an array, including when it contains one record.
        string payload = JsonSerializer.Serialize(updates, JsonOptions);
        using HttpRequestMessage request = SalesforceRequest(HttpMethod.Patch, endpoint, token, correlationId);
        request.Content = new StringContent(payload, Encoding.UTF8, "application/json");
        _payloadLogger.LogPayload("Salesforce", "IRMessages PATCH", "Request", payload, correlationId);
        using HttpResponseMessage response = await _httpClient.SendAsync(request, ct);
        string body = await response.Content.ReadAsStringAsync(ct);
        _payloadLogger.LogPayload("Salesforce", "IRMessages PATCH", "Response", body, correlationId);
        EnsureSuccess(response, "Salesforce PATCH", correlationId);
        ValidatePatchResponse(body, updates);
    }

    private static void ValidatePatchResponse(string body, IReadOnlyCollection<SalesforceIrMessageUpdate> updates)
    {
        if (string.IsNullOrWhiteSpace(body)) return;
        using JsonDocument document = JsonDocument.Parse(body);
        if (document.RootElement.ValueKind != JsonValueKind.Object)
            throw new InvalidOperationException("Unexpected Salesforce PATCH response shape.");
        JsonElement root = document.RootElement;
        if (root.TryGetProperty("failedRecords", out JsonElement failures) &&
            failures.ValueKind == JsonValueKind.Array && failures.GetArrayLength() > 0)
            throw new InvalidOperationException("Salesforce PATCH reported record-level failures.");
        if (!root.TryGetProperty("successfulRecords", out JsonElement successes)) return;
        if (successes.ValueKind != JsonValueKind.Array)
            throw new InvalidOperationException("Salesforce PATCH successfulRecords must be an array.");
        HashSet<string> acknowledged = new(StringComparer.Ordinal);
        foreach (JsonElement item in successes.EnumerateArray())
        {
            if (item.ValueKind != JsonValueKind.Object ||
                !item.TryGetProperty("recordId", out JsonElement id) ||
                id.ValueKind != JsonValueKind.String ||
                string.IsNullOrWhiteSpace(id.GetString()) || !acknowledged.Add(id.GetString()!))
                throw new InvalidOperationException("Invalid Salesforce PATCH successfulRecords entry.");
        }
        if (acknowledged.Count != updates.Count || updates.Any(u => !acknowledged.Contains(u.RecordId)))
            throw new InvalidOperationException("Salesforce PATCH did not acknowledge every submitted record.");
    }

    private static HttpRequestMessage SalesforceRequest(HttpMethod method, Uri endpoint,
        string token, string correlationId)
    {
        HttpRequestMessage request = new(method, endpoint);
        request.Headers.Authorization = new AuthenticationHeaderValue("Bearer", token);
        request.Headers.TryAddWithoutValidation("x-correlation-id", correlationId);
        request.Headers.Accept.Add(new MediaTypeWithQualityHeaderValue("application/json"));
        return request;
    }

    private static void EnsureSuccess(HttpResponseMessage response, string operation,
        string correlationId, string? recordId = null)
    {
        if (response.IsSuccessStatusCode) return;
        throw new HttpRequestException(
            $"{operation} failed. HTTP {(int)response.StatusCode}. RecordId: {recordId ?? "N/A"}. CorrelationId: {correlationId}",
            null, response.StatusCode);
    }

    private int GetMessageCount(string requestType)
    {
        string key = requestType == "new" ? "SalesforceIrNewMessageCount" : "SalesforceIrRetryMessageCount";
        if (!int.TryParse(Required(key), NumberStyles.Integer, CultureInfo.InvariantCulture, out int count) || count <= 0)
            throw new InvalidOperationException($"Invalid message count: {key}");
        return count;
    }

    private Uri BuildEndpoint(string hostKey, string pathKey)
    {
        string host = Required(hostKey);
        string path = Required(pathKey);
        if (!Uri.TryCreate(host, UriKind.Absolute, out Uri? baseUri) ||
            baseUri.Scheme != Uri.UriSchemeHttps ||
            !string.IsNullOrEmpty(baseUri.Query) || !string.IsNullOrEmpty(baseUri.Fragment) ||
            !path.StartsWith('/') || path.StartsWith("//") || path.Contains('?') || path.Contains('#'))
            throw new InvalidOperationException($"Invalid endpoint configuration: {hostKey}/{pathKey}");
        string combined = $"{host.TrimEnd('/')}/{path.TrimStart('/')}";
        if (!Uri.TryCreate(combined, UriKind.Absolute, out Uri? uri) || uri.Scheme != Uri.UriSchemeHttps)
            throw new InvalidOperationException($"Invalid HTTPS endpoint: {hostKey}/{pathKey}");
        return uri;
    }

    private string GetBasicAuth()
    {
        string value = Required("MaximoBasicAuth");
        if (value.StartsWith("Basic ", StringComparison.OrdinalIgnoreCase))
            value = value["Basic ".Length..].Trim();
        if (string.IsNullOrWhiteSpace(value))
            throw new InvalidOperationException("MaximoBasicAuth is empty.");
        return value;
    }

    private string Required(string key)
    {
        string? value = _configuration[key];
        return string.IsNullOrWhiteSpace(value)
            ? throw new InvalidOperationException($"Missing required configuration: {key}")
            : value.Trim();
    }
}
