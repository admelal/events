
using System.Globalization;
using System.Net.Http.Headers;
using System.Text;
using System.Text.Json;
using GaValveInspectionsSalesforce.Models;
using GaValveInspectionsSalesforce.Transformers;
using Microsoft.Extensions.Configuration;
using Microsoft.Extensions.Logging;

namespace GaValveInspectionsSalesforce.Services;

public sealed class SalesforceIrMessageService
{
    private const string NewRequestType = "new";
    private const string RetryRequestType = "retry";
    private const string SuccessStatus = "Success";
    private const string FailedStatus = "Failed";

    private static readonly JsonSerializerOptions JsonOptions = new()
    {
        PropertyNameCaseInsensitive = true
    };

    private readonly HttpClient _httpClient;
    private readonly IConfiguration _configuration;
    private readonly MaximoToSalesforceService _salesforceService;
    private readonly IntegrationPayloadLogger _payloadLogger;
    private readonly ILogger<SalesforceIrMessageService> _logger;

    public SalesforceIrMessageService(
        HttpClient httpClient,
        IConfiguration configuration,
        MaximoToSalesforceService salesforceService,
        IntegrationPayloadLogger payloadLogger,
        ILogger<SalesforceIrMessageService> logger)
    {
        _httpClient = httpClient
            ?? throw new ArgumentNullException(nameof(httpClient));
        _configuration = configuration
            ?? throw new ArgumentNullException(nameof(configuration));
        _salesforceService = salesforceService
            ?? throw new ArgumentNullException(nameof(salesforceService));
        _payloadLogger = payloadLogger
            ?? throw new ArgumentNullException(nameof(payloadLogger));
        _logger = logger
            ?? throw new ArgumentNullException(nameof(logger));
    }

    public Task<int> ProcessAsync(
        string correlationId,
        CancellationToken cancellationToken = default)
    {
        return ProcessAsync(
            NewRequestType,
            correlationId,
            cancellationToken);
    }

    public async Task<int> ProcessAsync(
        string requestType,
        string correlationId,
        CancellationToken cancellationToken = default)
    {
        if (requestType != NewRequestType &&
            requestType != RetryRequestType)
        {
            throw new ArgumentException(
                "RequestType must be 'new' or 'retry'.",
                nameof(requestType));
        }

        correlationId = string.IsNullOrWhiteSpace(correlationId)
            ? Guid.NewGuid().ToString("N")
            : correlationId.Trim();

        int messageCount = GetMessageCount(requestType);

        Uri salesforceEndpoint = BuildEndpoint(
            "SalesforceHost", "SalesforceIrMessagesPath");

        Uri maximoEndpoint = BuildEndpoint(
            "MaximoHost", "MaximoValvesPath");

        string token =
            await _salesforceService.GetSalesforceTokenAsync(
                correlationId);

        List<SalesforceIrMessage> messages =
            await GetMessagesAsync(
                salesforceEndpoint,
                token,
                requestType,
                messageCount,
                correlationId,
                cancellationToken);

        List<SalesforceIrMessageUpdate> updates = [];
        HashSet<string> processedIds = new(StringComparer.Ordinal);

        int succeeded = 0;
        int failed = 0;
        int unknown = 0;

        foreach (SalesforceIrMessage message in messages)
        {
            cancellationToken.ThrowIfCancellationRequested();

            string? recordId = message.Id?.Trim();

            if (string.IsNullOrWhiteSpace(recordId))
            {
                failed++;
                _logger.LogError(
                    "IRMessage missing Id. CorrelationId: {CorrelationId}",
                    correlationId);
                continue;
            }

            if (!processedIds.Add(recordId))
            {
                failed++;
                _logger.LogError(
                    "Duplicate IRMessage Id: {RecordId}",
                    recordId);
                continue;
            }

            try
            {
                if (message.Request is null)
                {
                    throw new InvalidOperationException(
                        "NG_Request__c is missing.");
                }

                string sourcePayload = message.Request.ToJsonString();

                _payloadLogger.LogPayload(
                    "Salesforce", "IRMessages Transformation",
                    "Before", sourcePayload, correlationId, recordId);

                string normalized =
                    SalesforceIrMessageNormalizer.Normalize(
                        sourcePayload);

                string maximoPayload =
                    SalesforceToMaximoStatusTransformer.Transform(
                        normalized, correlationId);

                using (JsonDocument doc = JsonDocument.Parse(maximoPayload))
                {
                    if (doc.RootElement.ValueKind != JsonValueKind.Object)
                    {
                        throw new InvalidOperationException(
                            "Maximo POST requires one JSON object.");
                    }
                }

                _payloadLogger.LogPayload(
                    "Maximo", "IRMessages Transformation",
                    "After", maximoPayload, correlationId, recordId);

                await SendToMaximoAsync(
                    maximoEndpoint,
                    maximoPayload,
                    recordId,
                    correlationId,
                    cancellationToken);

                updates.Add(new SalesforceIrMessageUpdate
                {
                    RecordId = recordId,
                    Status = SuccessStatus
                });

                succeeded++;
            }
            catch (OperationCanceledException)
                when (cancellationToken.IsCancellationRequested)
            {
                throw;
            }
            catch (OperationCanceledException ex)
            {
                unknown++;
                _logger.LogError(
                    ex,
                    "IRMessage outcome unknown. RecordId: {RecordId}",
                    recordId);
            }
            catch (HttpRequestException ex)
                when (ex.StatusCode is null)
            {
                unknown++;
                _logger.LogError(
                    ex,
                    "IRMessage transport failure. RecordId: {RecordId}",
                    recordId);
            }
            catch (Exception ex)
            {
                failed++;
                _logger.LogError(
                    ex,
                    "IRMessage processing failed. RecordId: {RecordId}",
                    recordId);

                updates.Add(new SalesforceIrMessageUpdate
                {
                    RecordId = recordId,
                    Status = FailedStatus
                });
            }
        }

        if (updates.Count > 0)
        {
            await PatchSalesforceAsync(
                salesforceEndpoint,
                token,
                updates,
                correlationId,
                cancellationToken);
        }

        _logger.LogInformation(
            "IRMessages completed. RequestType: {RequestType}, " +
            "Retrieved: {Retrieved}, Success: {Success}, " +
            "Failed: {Failed}, Unknown: {Unknown}, " +
            "CorrelationId: {CorrelationId}",
            requestType, messages.Count,
            succeeded, failed, unknown, correlationId);

        if (failed > 0 || unknown > 0)
        {
            throw new InvalidOperationException(
                $"IRMessages completed with {failed} failed and " +
                $"{unknown} unknown records. CorrelationId: {correlationId}");
        }

        return succeeded;
    }

    private async Task<List<SalesforceIrMessage>> GetMessagesAsync(
        Uri endpoint,
        string token,
        string requestType,
        int messageCount,
        string correlationId,
        CancellationToken ct)
    {
        UriBuilder uri = new(endpoint)
        {
            Query = $"requestType={Uri.EscapeDataString(requestType)}" +
                    $"&messageCount={messageCount.ToString(CultureInfo.InvariantCulture)}"
        };

        using HttpRequestMessage request =
            CreateRequest(HttpMethod.Get, uri.Uri, token, correlationId);

        _payloadLogger.LogPayload(
            "Salesforce", "IRMessages GET", "Request",
            JsonSerializer.Serialize(new
            {
                requestType,
                messageCount
            }), correlationId);

        using HttpResponseMessage response =
            await _httpClient.SendAsync(request, ct);

        string body = await response.Content.ReadAsStringAsync(ct);

        _payloadLogger.LogPayload(
            "Salesforce", "IRMessages GET", "Response",
            body, correlationId);

        EnsureSuccess(response, "Salesforce GET", correlationId);

        if (string.IsNullOrWhiteSpace(body))
        {
            throw new InvalidOperationException(
                "Salesforce GET returned an empty response.");
        }

        try
        {
            return JsonSerializer.Deserialize<List<SalesforceIrMessage>>(
                body, JsonOptions)
                ?? throw new InvalidOperationException(
                    "Salesforce GET returned null.");
        }
        catch (JsonException ex)
        {
            throw new InvalidOperationException(
                "Salesforce GET returned invalid JSON.", ex);
        }
    }

    private async Task SendToMaximoAsync(
        Uri endpoint,
        string payload,
        string recordId,
        string correlationId,
        CancellationToken ct)
    {
        string basicAuth = GetRequiredConfig("MaximoBasicAuth");

        if (basicAuth.StartsWith(
                "Basic ", StringComparison.OrdinalIgnoreCase))
        {
            basicAuth = basicAuth["Basic ".Length..].Trim();
        }

        using HttpRequestMessage request =
            new(HttpMethod.Post, endpoint);

        request.Headers.Authorization =
            new AuthenticationHeaderValue("Basic", basicAuth);

        request.Headers.TryAddWithoutValidation(
            "x-correlation-id", correlationId);

        request.Headers.Accept.Add(
            new MediaTypeWithQualityHeaderValue("application/json"));

        request.Content =
            new StringContent(payload, Encoding.UTF8, "application/json");

        _payloadLogger.LogPayload(
            "Maximo", "WorkOrder Status POST", "Request",
            payload, correlationId, recordId);

        using HttpResponseMessage response =
            await _httpClient.SendAsync(request, ct);

        string body = await response.Content.ReadAsStringAsync(ct);

        _payloadLogger.LogPayload(
            "Maximo", "WorkOrder Status POST", "Response",
            body, correlationId, recordId);

        EnsureSuccess(response, "Maximo POST", correlationId);
    }

    private async Task PatchSalesforceAsync(
        Uri endpoint,
        string token,
        IReadOnlyCollection<SalesforceIrMessageUpdate> updates,
        string correlationId,
        CancellationToken ct)
    {
        string payload = JsonSerializer.Serialize(updates, JsonOptions);

        using HttpRequestMessage request =
            CreateRequest(HttpMethod.Patch, endpoint, token, correlationId);

        request.Content =
            new StringContent(payload, Encoding.UTF8, "application/json");

        _payloadLogger.LogPayload(
            "Salesforce", "IRMessages PATCH", "Request",
            payload, correlationId);

        using HttpResponseMessage response =
            await _httpClient.SendAsync(request, ct);

        string body = await response.Content.ReadAsStringAsync(ct);

        _payloadLogger.LogPayload(
            "Salesforce", "IRMessages PATCH", "Response",
            body, correlationId);

        EnsureSuccess(response, "Salesforce PATCH", correlationId);
    }

    private static HttpRequestMessage CreateRequest(
        HttpMethod method,
        Uri endpoint,
        string token,
        string correlationId)
    {
        HttpRequestMessage request = new(method, endpoint);

        request.Headers.Authorization =
            new AuthenticationHeaderValue("Bearer", token);

        request.Headers.TryAddWithoutValidation(
            "x-correlation-id", correlationId);

        request.Headers.Accept.Add(
            new MediaTypeWithQualityHeaderValue("application/json"));

        return request;
    }

    private static void EnsureSuccess(
        HttpResponseMessage response,
        string operation,
        string correlationId)
    {
        if (!response.IsSuccessStatusCode)
        {
            throw new HttpRequestException(
                $"{operation} failed. " +
                $"StatusCode: {(int)response.StatusCode}. " +
                $"CorrelationId: {correlationId}",
                null,
                response.StatusCode);
        }
    }

    private int GetMessageCount(string requestType)
    {
        string key = requestType == NewRequestType
            ? "SalesforceIrNewMessageCount"
            : "SalesforceIrRetryMessageCount";

        if (!int.TryParse(
                GetRequiredConfig(key),
                NumberStyles.Integer,
                CultureInfo.InvariantCulture,
                out int count) ||
            count <= 0)
        {
            throw new InvalidOperationException(
                $"Invalid message count configuration: {key}");
        }

        return count;
    }

    private Uri BuildEndpoint(string hostKey, string pathKey)
    {
        string host = GetRequiredConfig(hostKey);
        string path = GetRequiredConfig(pathKey);

        if (!Uri.TryCreate(
                host, UriKind.Absolute, out Uri? baseUri) ||
            baseUri.Scheme != Uri.UriSchemeHttps
