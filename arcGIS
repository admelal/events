using System.Globalization;
using System.Net;
using System.Text.Json;
using System.Text.Json.Serialization;
using GaValveInspectionGisMaximo.Configuration;
using GaValveInspectionGisMaximo.Serialization;
using Microsoft.Extensions.Logging;
using Microsoft.Extensions.Options;

namespace GaValveInspectionGisMaximo.Services;

public sealed class ArcGisTokenProvider : IArcGisTokenProvider
{
  public const string HttpClientName = "ArcGisToken";

  private const int MaximumResponseCharacters = 65_536;

  private readonly IHttpClientFactory _httpClientFactory;
  private readonly ILogger<ArcGisTokenProvider> _logger;
  private readonly DownstreamOptions _options;
  private readonly Uri _tokenEndpoint;
  private readonly TimeSpan _requestTimeout;
  private readonly SemaphoreSlim _refreshLock = new(1, 1);

  private CachedToken? _cachedToken;

  public ArcGisTokenProvider(
      IHttpClientFactory httpClientFactory,
      IOptions<DownstreamOptions> options,
      ILogger<ArcGisTokenProvider> logger)
  {
    ArgumentNullException.ThrowIfNull(httpClientFactory);
    ArgumentNullException.ThrowIfNull(options);
    ArgumentNullException.ThrowIfNull(logger);

    _httpClientFactory = httpClientFactory;
    _logger = logger;
    _options = options.Value;

    _tokenEndpoint = BuildEndpoint(
        _options.GisHost,
        _options.GisTokenPath);

    _requestTimeout = TimeSpan.FromSeconds(
        _options.GisTimeoutSeconds);
  }

  public async Task<string> GetTokenAsync(
      CancellationToken cancellationToken)
  {
    var cachedToken = Volatile.Read(
        ref _cachedToken);

    if (IsUsable(cachedToken))
    {
      _logger.LogDebug(
          "Using cached ArcGIS access token. " +
          "ExpiresAtUtc={ExpiresAtUtc}, RefreshAtUtc={RefreshAtUtc}",
          cachedToken!.ExpiresAtUtc,
          GetRefreshAtUtc(cachedToken.ExpiresAtUtc));

      return cachedToken.Value;
    }

    await _refreshLock
        .WaitAsync(cancellationToken)
        .ConfigureAwait(false);

    try
    {
      // Another request may have refreshed the token while this
      // request was waiting for the lock.
      cachedToken = Volatile.Read(
          ref _cachedToken);

      if (IsUsable(cachedToken))
      {
        _logger.LogDebug(
            "Using ArcGIS access token refreshed by another request. " +
            "ExpiresAtUtc={ExpiresAtUtc}, RefreshAtUtc={RefreshAtUtc}",
            cachedToken!.ExpiresAtUtc,
            GetRefreshAtUtc(cachedToken.ExpiresAtUtc));

        return cachedToken.Value;
      }

      _logger.LogInformation(
          "Requesting a new ArcGIS access token. " +
          "TokenEndpoint={TokenEndpoint}, TokenClient={TokenClient}",
          _tokenEndpoint,
          _options.GisTokenClient);

      var refreshedToken = await RequestTokenAsync(
              cancellationToken)
          .ConfigureAwait(false);

      Volatile.Write(
          ref _cachedToken,
          refreshedToken);

      _logger.LogInformation(
          "ArcGIS access token generated and cached. " +
          "ExpiresAtUtc={ExpiresAtUtc}, RefreshAtUtc={RefreshAtUtc}",
          refreshedToken.ExpiresAtUtc,
          GetRefreshAtUtc(refreshedToken.ExpiresAtUtc));

      return refreshedToken.Value;
    }
    finally
    {
      _refreshLock.Release();
    }
  }

  private bool IsUsable(
      CachedToken? token)
  {
    if (token is null ||
        string.IsNullOrWhiteSpace(token.Value))
    {
      return false;
    }

    return DateTimeOffset.UtcNow <
           GetRefreshAtUtc(token.ExpiresAtUtc);
  }

  private DateTimeOffset GetRefreshAtUtc(
      DateTimeOffset expiresAtUtc)
  {
    return expiresAtUtc.AddMinutes(
        -_options.GisTokenRefreshSkewMinutes);
  }

  private async Task<CachedToken> RequestTokenAsync(
      CancellationToken cancellationToken)
  {
    var formValues =
        new List<KeyValuePair<string, string>>
        {
                new("f", "json"),
                new("username", _options.GisUsername),
                new("password", _options.GisPassword),
                new("client", _options.GisTokenClient),
                new(
                    "expiration",
                    _options.GisTokenExpirationMinutes.ToString(
                        CultureInfo.InvariantCulture))
        };

    if (string.Equals(
            _options.GisTokenClient,
            "referer",
            StringComparison.OrdinalIgnoreCase))
    {
      formValues.Add(
          new KeyValuePair<string, string>(
              "referer",
              _options.GisReferer));
    }

    using var timeoutSource =
        CancellationTokenSource.CreateLinkedTokenSource(
            cancellationToken);

    timeoutSource.CancelAfter(_requestTimeout);

    using var request = new HttpRequestMessage(
        HttpMethod.Post,
        _tokenEndpoint)
    {
      Content = new FormUrlEncodedContent(formValues)
    };

    var client = _httpClientFactory.CreateClient(
        HttpClientName);

    try
    {
      using var response = await client
          .SendAsync(
              request,
              HttpCompletionOption.ResponseHeadersRead,
              timeoutSource.Token)
          .ConfigureAwait(false);

      var responseBody = await response.Content
          .ReadLimitedStringAsync(
              MaximumResponseCharacters,
              timeoutSource.Token)
          .ConfigureAwait(false);

      if (!response.IsSuccessStatusCode)
      {
        _logger.LogError(
            "ArcGIS token endpoint returned an unsuccessful HTTP response. " +
            "HttpStatusCode={HttpStatusCode}",
            (int)response.StatusCode);

        throw DownstreamRequestException.ForHttpStatus(
            "ArcGIS token endpoint",
            response.StatusCode);
      }

      ArcGisClient.ThrowIfArcGisError(
          responseBody,
          "ArcGIS token endpoint");

      var tokenResponse = DeserializeTokenResponse(
          responseBody);

      var expiresAtUtc = GetExpiration(
          tokenResponse.Expires);

      return new CachedToken(
          tokenResponse.Token!,
          expiresAtUtc);
    }
    catch (OperationCanceledException exception)
        when (!cancellationToken.IsCancellationRequested)
    {
      _logger.LogError(
          exception,
          "The ArcGIS token request timed out. " +
          "TokenEndpoint={TokenEndpoint}",
          _tokenEndpoint);

      throw new DownstreamRequestException(
          "The ArcGIS token request timed out.",
          HttpStatusCode.RequestTimeout,
          isTransient: true,
          exception);
    }
    catch (HttpRequestException exception)
    {
      _logger.LogError(
          exception,
          "The ArcGIS token request failed due to a network error. " +
          "TokenEndpoint={TokenEndpoint}",
          _tokenEndpoint);

      throw new DownstreamRequestException(
          "The ArcGIS token request failed due to a network error.",
          exception.StatusCode,
          isTransient: true,
          exception);
    }
    catch (DownstreamRequestException exception)
    {
      _logger.LogError(
          exception,
          "The ArcGIS token request failed. " +
          "TokenEndpoint={TokenEndpoint}",
          _tokenEndpoint);

      throw;
    }
  }

  private static ArcGisTokenResponse DeserializeTokenResponse(
      string responseBody)
  {
    ArcGisTokenResponse? tokenResponse;

    try
    {
      tokenResponse =
          JsonSerializer.Deserialize<ArcGisTokenResponse>(
              responseBody,
              JsonDefaults.Options);
    }
    catch (JsonException exception)
    {
      throw new DownstreamRequestException(
          "The ArcGIS token endpoint returned an invalid JSON response.",
          statusCode: null,
          isTransient: false,
          exception);
    }

    if (tokenResponse is null ||
        string.IsNullOrWhiteSpace(tokenResponse.Token))
    {
      throw new DownstreamRequestException(
          "The ArcGIS token endpoint did not return a token.",
          statusCode: null,
          isTransient: false);
    }

    return tokenResponse;
  }

  private DateTimeOffset GetExpiration(
      long expires)
  {
    if (expires <= 0)
    {
      return DateTimeOffset.UtcNow.AddMinutes(
          _options.GisTokenExpirationMinutes);
    }

    try
    {
      var expiration =
          DateTimeOffset.FromUnixTimeMilliseconds(
              expires);

      if (expiration <= DateTimeOffset.UtcNow)
      {
        throw new DownstreamRequestException(
            "The ArcGIS token endpoint returned an expired token.",
            statusCode: null,
            isTransient: false);
      }

      return expiration;
    }
    catch (ArgumentOutOfRangeException exception)
    {
      throw new DownstreamRequestException(
          "The ArcGIS token endpoint returned an invalid expiration value.",
          statusCode: null,
          isTransient: false,
          exception);
    }
  }

  private static Uri BuildEndpoint(
      string host,
      string path)
  {
    ArgumentException.ThrowIfNullOrWhiteSpace(host);
    ArgumentException.ThrowIfNullOrWhiteSpace(path);

    var baseUri = new Uri(
        $"{host.TrimEnd('/')}/",
        UriKind.Absolute);

    return new Uri(
        baseUri,
        path.TrimStart('/'));
  }

  private sealed record CachedToken(
      string Value,
      DateTimeOffset ExpiresAtUtc);

  private sealed class ArcGisTokenResponse
  {
    [JsonPropertyName("token")]
    public string? Token { get; init; }

    [JsonPropertyName("expires")]
    public long Expires { get; init; }
  }
}


