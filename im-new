<policies>
    <inbound>
        <base />

        <!--
            Preserve the caller's correlation ID.
            Generate one only when it is missing.
        -->
        <set-variable name="correlationId" value='@{
            var correlationId =
                context.Request.Headers.GetValueOrDefault(
                    "x-correlation-id",
                    string.Empty);

            return string.IsNullOrWhiteSpace(correlationId)
                ? Guid.NewGuid().ToString("D")
                : correlationId.Trim();
        }' />

        <!-- A unique ID for this individual Service Bus message. -->
        <set-variable name="messageId"
                      value="@(Guid.NewGuid().ToString(&quot;D&quot;))" />

        <!-- Read and normalize routing headers. -->
        <set-variable name="sourceSystem" value='@{
            var source =
                context.Request.Headers.GetValueOrDefault(
                    "ng_source",
                    string.Empty);

            return source.Trim();
        }' />

        <set-variable name="targetSystem" value='@{
            var target =
                context.Request.Headers.GetValueOrDefault(
                    "ng_target",
                    string.Empty);

            return target.Trim();
        }' />

        <!-- Determine the integration direction. -->
        <set-variable name="messageType" value='@{
            var source =
                (string)context.Variables["sourceSystem"];

            var target =
                (string)context.Variables["targetSystem"];

            if (source.Equals(
                    "GIS",
                    StringComparison.OrdinalIgnoreCase) &&
                target.Equals(
                    "Maximo",
                    StringComparison.OrdinalIgnoreCase))
            {
                return "GisToMaximo";
            }

            if (source.Equals(
                    "Maximo",
                    StringComparison.OrdinalIgnoreCase) &&
                target.Equals(
                    "GIS",
                    StringComparison.OrdinalIgnoreCase))
            {
                return "MaximoToGis";
            }

            return string.Empty;
        }' />

        <!-- Reject unsupported routing before publishing. -->
        <choose>
            <when condition='@(
                string.IsNullOrWhiteSpace(
                    (string)context.Variables["messageType"])
            )'>
                <return-response>
                    <set-status code="400" reason="Bad Request" />

                    <set-header name="Content-Type"
                                exists-action="override">
                        <value>application/json</value>
                    </set-header>

                    <set-header name="x-correlation-id"
                                exists-action="override">
                        <value>@(
                            (string)context.Variables["correlationId"]
                        )</value>
                    </set-header>

                    <set-body>@{
                        return new Newtonsoft.Json.Linq.JObject(
                            new Newtonsoft.Json.Linq.JProperty(
                                "statusCode",
                                400),
                            new Newtonsoft.Json.Linq.JProperty(
                                "code",
                                "INVALID_ROUTE"),
                            new Newtonsoft.Json.Linq.JProperty(
                                "message",
                                "Supported routes are GIS to Maximo and Maximo to GIS."),
                            new Newtonsoft.Json.Linq.JProperty(
                                "source",
                                (string)context.Variables[
                                    "sourceSystem"]),
                            new Newtonsoft.Json.Linq.JProperty(
                                "target",
                                (string)context.Variables[
                                    "targetSystem"]),
                            new Newtonsoft.Json.Linq.JProperty(
                                "correlationId",
                                (string)context.Variables[
                                    "correlationId"])
                        ).ToString(
                            Newtonsoft.Json.Formatting.None);
                    }</set-body>
                </return-response>
            </when>
        </choose>

        <!-- Parse the original request while preserving its content. -->
        <set-variable id="parse-request-payload"
                      name="requestPayload"
                      value='@(
            context.Request.Body.As<
                Newtonsoft.Json.Linq.JObject
            >(preserveContent: true)
        )' />

        <!-- Create the common Service Bus envelope. -->
        <set-variable name="serviceBusMessage" value='@{
            var messageType =
                (string)context.Variables["messageType"];

            var correlationId =
                (string)context.Variables["correlationId"];

            var requestPayload =
                (Newtonsoft.Json.Linq.JObject)
                    context.Variables["requestPayload"];

            return new Newtonsoft.Json.Linq.JObject(
                new Newtonsoft.Json.Linq.JProperty(
                    "messageType",
                    messageType),
                new Newtonsoft.Json.Linq.JProperty(
                    "correlationId",
                    correlationId),
                new Newtonsoft.Json.Linq.JProperty(
                    "receivedAtUtc",
                    DateTime.UtcNow.ToString("O")),
                new Newtonsoft.Json.Linq.JProperty(
                    "payload",
                    requestPayload)
            ).ToString(
                Newtonsoft.Json.Formatting.None);
        }' />

        <!--
            Broker properties:
            MessageId identifies this Service Bus message.
            CorrelationId identifies the complete business transaction.
            Label/Subject identifies the integration direction.
        -->
        <set-header name="BrokerProperties"
                    exists-action="override">
            <value>@{
                return new Newtonsoft.Json.Linq.JObject(
                    new Newtonsoft.Json.Linq.JProperty(
                        "MessageId",
                        (string)context.Variables["messageId"]),
                    new Newtonsoft.Json.Linq.JProperty(
                        "CorrelationId",
                        (string)context.Variables[
                            "correlationId"]),
                    new Newtonsoft.Json.Linq.JProperty(
                        "Label",
                        (string)context.Variables["messageType"]),
                    new Newtonsoft.Json.Linq.JProperty(
                        "ContentType",
                        "application/json")
                ).ToString(
                    Newtonsoft.Json.Formatting.None);
            }</value>
        </set-header>

        <!-- Service Bus application properties. -->
        <set-header name="messageType"
                    exists-action="override">
            <value>@(
                (string)context.Variables["messageType"]
            )</value>
        </set-header>

        <set-header name="ng_source"
                    exists-action="override">
            <value>@(
                (string)context.Variables["sourceSystem"]
            )</value>
        </set-header>

        <set-header name="ng_target"
                    exists-action="override">
            <value>@(
                (string)context.Variables["targetSystem"]
            )</value>
        </set-header>

        <set-header name="x-correlation-id"
                    exists-action="override">
            <value>@(
                (string)context.Variables["correlationId"]
            )</value>
        </set-header>

        <set-header name="Content-Type"
                    exists-action="override">
            <value>application/json</value>
        </set-header>

        <!-- Do not forward caller credentials to Service Bus. -->
        <set-header name="Authorization"
                    exists-action="delete" />

        <set-header name="Ocp-Apim-Subscription-Key"
                    exists-action="delete" />

        <!-- Record routing information in APIM diagnostics. -->
        <trace source="ValveInspectionRouting"
               severity="information">
            <message>Publishing valve inspection message to Service Bus</message>

            <metadata name="correlationId"
                      value="@((string)context.Variables[&quot;correlationId&quot;])" />

            <metadata name="messageId"
                      value="@((string)context.Variables[&quot;messageId&quot;])" />

            <metadata name="messageType"
                      value="@((string)context.Variables[&quot;messageType&quot;])" />

            <metadata name="source"
                      value="@((string)context.Variables[&quot;sourceSystem&quot;])" />

            <metadata name="target"
                      value="@((string)context.Variables[&quot;targetSystem&quot;])" />
        </trace>

        <!-- Publish to the Service Bus topic. -->
        <set-backend-service
            backend-id="ga-common-servicebus-namespace" />

        <rewrite-uri
            template="/{{ga-valvesgismx-topic-name}}/messages"
            copy-unmatched-params="false" />

        <authentication-managed-identity
            resource="https://servicebus.azure.net/"
            ignore-error="false" />

        <set-body>@(
            (string)context.Variables["serviceBusMessage"]
        )</set-body>
    </inbound>

    <backend>
        <forward-request timeout="60" />
    </backend>

    <outbound>
        <choose>
            <!-- Service Bus accepted the message. -->
            <when condition='@(
                context.Response.StatusCode >= 200 &&
                context.Response.StatusCode < 300
            )'>
                <set-status code="202" reason="Accepted" />

                <set-header name="Content-Type"
                            exists-action="override">
                    <value>application/json</value>
                </set-header>

                <set-header name="x-correlation-id"
                            exists-action="override">
                    <value>@(
                        (string)context.Variables["correlationId"]
                    )</value>
                </set-header>

                <set-body>@{
                    var source =
                        (string)context.Variables[
                            "sourceSystem"];

                    var target =
                        (string)context.Variables[
                            "targetSystem"];

                    var messageType =
                        (string)context.Variables[
                            "messageType"];

                    var message =
                        $"The request was accepted for {target} processing.";

                    return new Newtonsoft.Json.Linq.JObject(
                        new Newtonsoft.Json.Linq.JProperty(
                            "statusCode",
                            202),
                        new Newtonsoft.Json.Linq.JProperty(
                            "status",
                            "Accepted"),
                        new Newtonsoft.Json.Linq.JProperty(
                            "message",
                            message),
                        new Newtonsoft.Json.Linq.JProperty(
                            "source",
                            source),
                        new Newtonsoft.Json.Linq.JProperty(
                            "target",
                            target),
                        new Newtonsoft.Json.Linq.JProperty(
                            "messageType",
                            messageType),
                        new Newtonsoft.Json.Linq.JProperty(
                            "messageId",
                            (string)context.Variables[
                                "messageId"]),
                        new Newtonsoft.Json.Linq.JProperty(
                            "correlationId",
                            (string)context.Variables[
                                "correlationId"])
                    ).ToString(
                        Newtonsoft.Json.Formatting.None);
                }</set-body>
            </when>

            <!-- Service Bus rejected the publication. -->
            <otherwise>
                <set-status code="502" reason="Bad Gateway" />

                <set-header name="Content-Type"
                            exists-action="override">
                    <value>application/json</value>
                </set-header>

                <set-header name="x-correlation-id"
                            exists-action="override">
                    <value>@(
                        (string)context.Variables["correlationId"]
                    )</value>
                </set-header>

                <set-body>@{
                    return new Newtonsoft.Json.Linq.JObject(
                        new Newtonsoft.Json.Linq.JProperty(
                            "statusCode",
                            502),
                        new Newtonsoft.Json.Linq.JProperty(
                            "code",
                            "SERVICE_BUS_PUBLISH_FAILED"),
                        new Newtonsoft.Json.Linq.JProperty(
                            "message",
                            "The request could not be published for processing."),
                        new Newtonsoft.Json.Linq.JProperty(
                            "messageType",
                            (string)context.Variables[
                                "messageType"]),
                        new Newtonsoft.Json.Linq.JProperty(
                            "messageId",
                            (string)context.Variables[
                                "messageId"]),
                        new Newtonsoft.Json.Linq.JProperty(
                            "correlationId",
                            (string)context.Variables[
                                "correlationId"])
                    ).ToString(
                        Newtonsoft.Json.Formatting.None);
                }</set-body>
            </otherwise>
        </choose>
    </outbound>

    <on-error>
        <set-header name="Content-Type"
                    exists-action="override">
            <value>application/json</value>
        </set-header>

        <set-header name="x-correlation-id"
                    exists-action="override">
            <value>@{
                return context.Variables.ContainsKey(
                    "correlationId")
                    ? (string)context.Variables[
                        "correlationId"]
                    : context.RequestId.ToString();
            }</value>
        </set-header>

        <set-status code='@(
            context.LastError?.PolicyId ==
                "parse-request-payload"
                ? 400
                : 500
        )'
        reason='@(
            context.LastError?.PolicyId ==
                "parse-request-payload"
                ? "Bad Request"
                : "Internal Server Error"
        )' />

        <set-body>@{
            var invalidJson =
                context.LastError?.PolicyId ==
                    "parse-request-payload";

            var correlationId =
                context.Variables.ContainsKey(
                    "correlationId")
                    ? (string)context.Variables[
                        "correlationId"]
                    : context.RequestId.ToString();

            var messageId =
                context.Variables.ContainsKey("messageId")
                    ? (string)context.Variables["messageId"]
                    : null;

            return new Newtonsoft.Json.Linq.JObject(
                new Newtonsoft.Json.Linq.JProperty(
                    "statusCode",
                    invalidJson ? 400 : 500),
                new Newtonsoft.Json.Linq.JProperty(
                    "code",
                    invalidJson
                        ? "INVALID_JSON"
                        : "INTERNAL_SERVER_ERROR"),
                new Newtonsoft.Json.Linq.JProperty(
                    "message",
                    invalidJson
                        ? "The request body must contain a valid JSON object."
                        : "The request could not be processed."),
                new Newtonsoft.Json.Linq.JProperty(
                    "messageId",
                    messageId),
                new Newtonsoft.Json.Linq.JProperty(
                    "correlationId",
                    correlationId),
                new Newtonsoft.Json.Linq.JProperty(
                    "activityId",
                    context.RequestId.ToString())
            ).ToString(
                Newtonsoft.Json.Formatting.None);
        }</set-body>
    </on-error>
</policies>
