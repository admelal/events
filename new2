<policies>
    <inbound>
        <base />
        <set-variable name="correlationId" value="@{
           var value = context.Request.Headers.GetValueOrDefault("x-correlation-id", "");
           return string.IsNullOrWhiteSpace(value) ? Guid.NewGuid().ToString() : value.Trim();
       }" />
        <validate-jwt header-name="Authorization" failed-validation-httpcode="401" failed-validation-error-message="Unauthorized" require-expiration-time="true" require-signed-tokens="true">
            <openid-config url="{{ga-common-openid-config-url}}" />
            <issuers>
                <issuer>{{ga-common-openid-issuer}}</issuer>
            </issuers>
        </validate-jwt>
        <set-header name="x-correlation-id" exists-action="override">
            <value>@((string)context.Variables["correlationId"])</value>
        </set-header>
        <set-variable name="Source-System" value="@(
           context.Request.Headers.GetValueOrDefault("ng_source", "").Trim().ToUpperInvariant()
       )" />
        <set-variable name="Target-System" value="@(
           context.Request.Headers.GetValueOrDefault("ng_target", "").Trim().ToUpperInvariant()
       )" />
        <set-variable name="requestValidationError" value="@{
           if (!context.Request.HasBody)
           {
               return "The request body is required.";
           }

           var body = context.Request.Body.As&lt;string&gt;(preserveContent: true);
           if (string.IsNullOrWhiteSpace(body))
           {
               return "The request body is required.";
           }

           try
           {
               var requestJson = JObject.Parse(body);
               var fundingProjectRequest = requestJson["FundingProjectRequest"] as JObject;

               if (fundingProjectRequest == null || !fundingProjectRequest.HasValues)
               {
                   return "FundingProjectRequest must be a non-null, nonempty object.";
               }

               return string.Empty;
           }
           catch
           {
               return "The request body must contain a valid JSON object.";
           }
       }" />
        <choose>
            <when condition="@(!string.IsNullOrWhiteSpace((string)context.Variables["requestValidationError"]))">
                <return-response>
                    <set-status code="400" reason="Bad Request" />
                    <set-header name="Content-Type" exists-action="override">
                        <value>application/json</value>
                    </set-header>
                    <set-header name="x-correlation-id" exists-action="override">
                        <value>@((string)context.Variables["correlationId"])</value>
                    </set-header>
                    <set-body>@{
                       return new JObject
                       {
                           ["fundingProjectResponse"] = new JObject
                           {
                               ["code"] = 400,
                               ["interface"] = "Finance Master - Funding Project",
                               ["responsedata"] = null,
                               ["severity"] = "Error",
                               ["correlationId"] = (string)context.Variables["correlationId"],
                               ["message"] = (string)context.Variables["requestValidationError"],
                               ["status"] = "Failed"
                           }
                       }.ToString();
                   }</set-body>
                </return-response>
            </when>
        </choose>
        <choose>
            <when condition="@(
               (string)context.Variables["Source-System"] == "SAP"
               &amp;&amp; (string)context.Variables["Target-System"] == "C55"
           )">
                <set-backend-service backend-id="common-rtf-muga-host" />
                <rewrite-uri template="{{ga-c55-financials-basepath}}/v1/fundingprojects" copy-unmatched-params="false" />
            </when>
            <when condition="@(
               (string)context.Variables["Source-System"] == "POWERPLAN"
               &amp;&amp; (string)context.Variables["targetSystem"] == "MAXIMO"
           )">
                <set-backend-service backend-id="common-rtf-muga-host" />
                <rewrite-uri template="/{{ga-maximo-financials-basepath}}/v1/fundingprojects" copy-unmatched-params="false" />
            </when>
            <otherwise>
                <return-response>
                    <set-status code="400" reason="Bad Request" />
                    <set-header name="Content-Type" exists-action="override">
                        <value>application/json</value>
                    </set-header>
                    <set-header name="x-correlation-id" exists-action="override">
                        <value>@((string)context.Variables["correlationId"])</value>
                    </set-header>
                    <set-body>@{
                       return new JObject
                       {
                           ["fundingProjectResponse"] = new JObject
                           {
                               ["code"] = 400,
                               ["interface"] = "Finance Master - Funding Project",
                               ["responsedata"] = null,
                               ["severity"] = "Error",
                               ["correlationId"] = (string)context.Variables["correlationId"],
                               ["message"] = "Unsupported route. Use ng_source=SAP with ng_target=C55, or ng_source=PowerPlan with ng_target=Maximo.",
                               ["status"] = "Failed"
                           }
                       }.ToString();
                   }</set-body>
                </return-response>
            </otherwise>
        </choose>
        <set-header name="Content-Type" exists-action="override">
            <value>application/json</value>
        </set-header>
    </inbound>
    <backend>
        <base />
    </backend>
    <outbound>
        <base />
        <!-- Preserve the backend response body, content type, and HTTP status. -->
        <set-header name="x-correlation-id" exists-action="override">
            <value>@((string)context.Variables["correlationId"])</value>
        </set-header>
    </outbound>
    <on-error>
        <base />
        <set-header name="x-correlation-id" exists-action="override">
            <value>@(
               context.Variables.ContainsKey("correlationId")
                   ? (string)context.Variables["correlationId"]
                   : Guid.NewGuid().ToString()
           )</value>
        </set-header>
    </on-error>
</policies>
